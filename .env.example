# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
# Origin of the FastAPI server (no /api/v1 suffix)
BACKEND_URL=http://localhost:8000
# Optional alias (Vite-style). If set, the Streamlit app uses this as the API origin.
# VITE_API_BASE_URL=https://gridlock-hackathon-ai.onrender.com

# Database
DATABASE_URL=sqlite+aiosqlite:///./traffic_ai.db

# ML Models (downloads automatically on first run)
YOLO_VEHICLE_MODEL=yolov8n.pt
YOLO_HELMET_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
DEVICE=cpu

# Processing
FRAME_SKIP=2
HEATMAP_DECAY=0.98

# Congestion Thresholds
CONGESTION_LOW=0.25
CONGESTION_MEDIUM=0.50
CONGESTION_HEAVY=0.75

# Streamlit
STREAMLIT_PORT=8501
